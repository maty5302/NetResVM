@using BusinessLayer.Enum
@{
    ViewData["Title"] = @Localizer["ManageBackup"];
    var backups= ViewBag.Backups as List<BusinessLayer.DTOs.BackupDTO>;
}
<h1>@ViewData["Title"]</h1>
<br/>
<div>
    @if(backups == null || backups.Count==0)
    {
        <div class="col-12 text-center mt-4">
            <div class="alert alert-info" role="alert">
                @Localizer["NoBackups"]
            </div>
            </div> 
    }
    else
    {
        
        <table class="table">
            <thead>
            <tr>
                <th>@Localizer["ServerName"]</th>
                <th>@Localizer["ServerType"]</th>
                <th>@Localizer["Lab"]</th>
                <th>@Localizer["CreatedAt"]</th>
                <th>@Localizer["Actions"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var backup in backups)
            {
                <tr>
                    <td>@backup.ServerName</td>
                    <td>@backup.Platform.ToString()</td>
                    <td>@backup.LabId</td>
                    <td>@backup.CreatedAt</td>
                    <td>
                        <form method="post">
                            @if (backup.ServerId == -1 || backup.Platform == PlatformType.EVE)
                            {
                                <button class="btn btn-primary" disabled><i class="bi bi-arrow-clockwise"></i></button>
                            }
                            else
                            {
                                <button type="submit"
                                        data-confirm="@Localizer["MessageWarningRestoreBackup"]"
                                        onclick="return confirm(this.getAttribute('data-confirm'));"
                                        formaction="@Url.Action("RestoreBackup", "Backup", new { serverId = @backup.ServerId, labId = @backup.LabId, platform = @backup.Platform, filename = @backup.FileName })"
                                        class="btn btn-primary">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            }
                            <button type="submit" formaction="@Url.Action("DownloadBackup", "Backup", new { labId = @backup.LabId, platform = @backup.Platform, filename = @backup.FileName })" class="btn btn-primary"><i class="bi bi-download"></i></button>
                            <button type="submit"
                                    data-confirm="@Localizer["MessageWarningDeleteBackup"]"
                                    onclick="return confirm(this.getAttribute('data-confirm'));"
                                    formaction="@Url.Action("DeleteBackup", "Backup", new { filename = @backup.FileName, labId = @backup.LabId, platform = @backup.Platform })"
                                    class="btn btn-danger"> <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
