@model NetResVM.Models.LoginModel
@{
    ViewData["Title"] = "Log in";
}
<div class="container mt-5">
    <h2 class="mb-4">@Localizer["Login"]</h2>

    <form asp-action="LoginASync" asp-controller="Login" method="post" class="p-4 border rounded">

        <div class="form-group mb-3">
			<label class="form-label" for="Username">@Localizer["Username"]</label>
			<input type="text" class="form-control" asp-for="Username" required>
        </div>

        <div class="form-group mb-3">
            <label for="Password" class="form-label">@Localizer["Password"]</label>
            <input asp-for="Password" class="form-control" type="password" required>
        </div>
        <hr class="my-4"/>
        <button type="submit" class="btn btn-primary w-100">@Localizer["LoginButton"]</button>
    </form>    


</div>

