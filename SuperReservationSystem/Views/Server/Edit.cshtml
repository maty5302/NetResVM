@using BusinessLayer.Enum @* Přidej namespace tvého enumu *@
@model BusinessLayer.Models.ServerModel
@{
    ViewData["Title"] = "Edit server";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <h1>@ViewData["Title"]</h1>
            <hr />
            
            <form method="post" class="p-4 border rounded shadow-sm">
                
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold" asp-for="Platform">Server type:</label>
                    <select asp-for="Platform" class="form-select" 
                            asp-items="@(Html.GetEnumSelectList<PlatformType>().Where(e => e.Value != "0"))">
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold" asp-for="IpAddress">Server IP / URL:</label>
                    <input type="text" class="form-control" asp-for="IpAddress" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold" asp-for="Name">Name:</label>
                    <input type="text" class="form-control" asp-for="Name" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold" asp-for="Username">Login:</label>
                    <input type="text" class="form-control" asp-for="Username" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold" asp-for="Password">Password:</label>
                    <input type="password" class="form-control" asp-for="Password" placeholder="(Leave blank to keep unchanged)" />
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-between">
                    <button class="btn btn-outline-secondary" type="submit" formaction="@Url.Action("TestConnection","Server", new { edit=true })">
                        <i class="bi bi-wifi"></i> Test connection
                    </button>
                    <button class="btn btn-primary" type="submit" formaction="@Url.Action("SaveChanges","Server")">
                        <i class="bi bi-save"></i> Save changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>