@model List<BusinessLayer.DTOs.NodeDTO>
@{
    ViewData["Title"] = ViewBag.Title ?? "Lab Nodes";
}

<h1>@ViewData["Title"]</h1>
<hr />

<div class="row">
    @if (Model != null && Model.Count > 0)
    {
        @for (int i = 0; i < Model.Count; i++)
        {
            var node = Model[i];
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4 d-flex">
                <div class="card flex-fill d-flex flex-column">
                    @* Fixed the typo 'sstyle' to standard style *@
                    <div class="card-body" style="min-height: 175px;">
                        <h5 class="card-title">@node.Name</h5>
                        <hr />

                        @* Universal Status with color coding *@
                        <span class="mb-2 d-block"> 
                            @{
                                var isStarted = node.Status.Equals("STARTED", StringComparison.OrdinalIgnoreCase);
                                var iconColor = isStarted ? "text-success" : "text-secondary";
                            }
                            <i class="bi bi-caret-right-fill @iconColor"></i> 
                            <strong>@node.Status.ToUpper()</strong>
                        </span>

                        @* Standard Properties from NodeDTO *@
                        <span> <i class="bi bi-cpu"></i> CPU: @node.NumberOfCPU</span><br />
                        <span> <i class="bi bi-memory"></i> RAM: @node.Memory MB</span><br />

                        @* Platform-Specific Metadata (Ethernets, HDD, CPU Limit) *@
                        @if (node.Metadata != null && node.Metadata.Any())
                        {
                            @foreach (var meta in node.Metadata)
                            {
                                // Dynamically assign icons based on common metadata keys
                                string icon = "bi-info-circle";
                                if (meta.Key.Contains("Ethernet", StringComparison.OrdinalIgnoreCase)) icon = "bi-ethernet";
                                else if (meta.Key.Contains("HDD") || meta.Key.Contains("Volume")) icon = "bi-hdd";
                                else if (meta.Key.Contains("Limit")) icon = "bi-speedometer2";

                                <span> <i class="bi @icon"></i> @meta.Key: @meta.Value</span><br />
                            }
                        }

                        @* Optional Console Button (from your CML code) *@
                        @* <div class="mt-3">
                        @if (isStarted)
                        {
                            <form method="post">
                                <button class="btn btn-sm btn-primary w-100">Show console output</button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary w-100" disabled>Show console output</button>
                        }
                        </div>
                        *@
                    </div>
                </div>
            </div>
            
            @* Wrap rows nicely *@
            @if ((i + 1) % 4 == 0)
            {
                <div class="w-100 d-none d-lg-block"></div>
            }
        }
    }
    else
    {
        <div class="col-12 text-center mt-4">
            <div class="alert alert-info" role="alert">
                No nodes available in this lab.
            </div>
        </div>
    }
</div>