@model BusinessLayer.DTOs.LabDTO
@{
    // Název stránky dynamicky podle modelu
    ViewData["Title"] = "Lab Info - " + (Model?.Name ?? "Unknown");
}

@if (Model == null)
{
    <div class="alert alert-danger">Lab information could not be loaded.</div>
}
else
{
    <h1>@Model.Name</h1>
    <hr />
    
    <div class="row mb-4">
        <div class="col-md-6">
            <h4>General Details</h4>
            <p><strong>Lab ID:</strong> @Model.Id</p>
            <p><strong>Lab Name:</strong> @Model.Name</p>
            <p><strong>Status:</strong> <span class="badge bg-secondary">@Model.Status</span></p>
            
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p><strong>Description:</strong> @Model.Description</p>
            }
        </div>
        
        <div class="col-md-6">
            <h4>Platform Specifics</h4>
            @* Zde se automaticky vypíše Path (pro EVE) nebo LinkCount (pro CML) atd. *@
            @if (Model.Metadata != null && Model.Metadata.Any())
            {
                <ul class="list-unstyled">
                    @foreach (var meta in Model.Metadata)
                    {
                        <li><strong>@meta.Key:</strong> @meta.Value</li>
                    }
                </ul>
            }
        </div>
    </div>

    @* Akční tlačítka - Všechny přesměrovány na PlatformController *@
    <form method="post">    
        <div class="mb-3">
            <div class="btn-group mb-2" role="group">
                <button type="submit" class="btn btn-secondary"
                        formaction="@Url.Action("LabList", "Platform", new { id = ViewBag.ServerId })">
                    <i class="bi bi-arrow-left-circle"></i> Back to Lab List
                </button>
                <button type="submit" class="btn btn-info"
                        formaction="@Url.Action("LabNodeList", "Platform", new { serverId = ViewBag.ServerId, labId = Model.Id })">
                    <i class="bi bi-diagram-3"></i> Show Nodes
                </button>
            </div>
        </div>

        <div class="mb-3">
            <div class="btn-group mb-2" role="group">
                <button type="submit" class="btn btn-primary"
                        formaction="@Url.Action("MakeBackup", "Backup", new { serverId = ViewBag.ServerId, labId = Model.Id, serverType = ViewBag.PlatformName, fromServer = true })">
                    <i class="bi bi-cloud-arrow-up"></i> Backup Lab
                </button>
                <button type="submit" class="btn btn-primary"
                        formaction="@Url.Action("DownloadLab", "Platform", new { serverId = ViewBag.ServerId, labId = Model.Id })">
                    <i class="bi bi-download"></i> Download Lab
                </button>
                <button type="submit" class="btn btn-primary"
                        formaction="@Url.Action("Create", "Reservation", new { selectedServer = ViewBag.ServerId, labId = Model.Id })">
                    <i class="bi bi-calendar-check"></i> Reserve This Lab
                </button>
                
                @* Vlastnictví laboratoře *@
                @if (ViewBag.Owned == true)
                {
                    <button class="btn btn-outline-secondary" disabled>
                        <i class="bi bi-person-check"></i> Own a Lab
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary"
                            formaction="@Url.Action("OwnLab", "User", new { serverId = ViewBag.ServerId, labId = Model.Id })">
                        <i class="bi bi-person-plus"></i> Own a Lab
                    </button>
                }
                @if (ViewBag.UserOwn == true || User.IsInRole("Admin"))
                    {
                        <button type="submit" class="btn btn-outline-secondary"
                                formaction="@Url.Action("ReleaseLab", "User", new { serverId = ViewBag.ServerId, labId = Model.Id })">
                            <i class="bi bi-person-x"></i> Release Lab
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary" disabled>
                            <i class="bi bi-person-x"></i> Release Lab
                        </button>
                    }
                    @* fix and implement collaborator management later *@
                    <button class="btn btn-outline-secondary" disabled>
                        <i class="bi bi-person-plus"></i> Add Collaborator
                    </button>
            </div>
        </div>

        @* Pokud uživatel laboratoř vlastní, nebo je admin, může s ní manipulovat *@
        @if (ViewBag.UserOwn == true || User.IsInRole("Admin"))
        {
            <div class="mb-3">
                <div class="btn-group mb-2" role="group">
                    <button type="submit" class="btn btn-success"
                            formaction="@Url.Action("StartLab", "Platform", new { serverId = ViewBag.ServerId, labId = Model.Id })">
                        <i class="bi bi-play-circle"></i> Start This Lab
                    </button>
                    <button type="submit" class="btn btn-warning"
                            formaction="@Url.Action("StopLab", "Platform", new { serverId = ViewBag.ServerId, labId = Model.Id })">
                        <i class="bi bi-stop-circle"></i> Stop the Lab
                    </button>
                </div>
            </div>
        }

        @* Práva pouze pro Admina *@
        @if (User.IsInRole("Admin"))
        {
            <div class="mb-3">
                <button type="submit" class="btn btn-danger"
                        formaction="@Url.Action("DeleteLab", "Platform", new { serverId = ViewBag.ServerId, labId = Model.Id })"
                        onclick="return confirm('Are you sure you want to permanently delete this lab?')">
                    <i class="bi bi-trash"></i> Delete This Lab
                </button>
            </div>
        }
    </form>
}