#Soubor .env potřebný pro spuštění v Dockeru. Poznámka: tohle je jen ukázkový soubor. 
#File .env is needed for running in docker. Note: this is just an example. 
DB_USER=sa
DB_PASSWORD=vase_silne_heslo
#Maximální počet současně spuštěných laboratoří na jednom serveru (výchozí 2).
#Maximum number of simultaneously running labs on one server (default 2).
MAX_RUNNING_LABS_PER_SERVER=2
#Minimální délka rezervace v minutách (výchozí 60).
#Minimum reservation length in minutes (default 60).
MIN_RESERVATION_MINUTES=60
