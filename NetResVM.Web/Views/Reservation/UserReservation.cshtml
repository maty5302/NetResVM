@using NetResVM.Web.Models

@{
	ViewData["Title"] = @Localizer["MyReservations"];

	var reservations = ((List<ReservationInformationModel>)ViewBag.PlannedReservations);
	var expired = ((List<ReservationInformationModel>)ViewBag.ExpiredReservations);
}
<h1>@ViewData["Title"]</h1>
<hr />
<div>
	<h3>@Localizer["PlannedReservations"]</h3>
	@if (reservations != null && reservations.Count > 0)
	{
		<table class="table">
			<thead>
			<tr>
				<th>@Localizer["Server"]</th>
				<th>@Localizer["Lab"]</th>
				<th>@Localizer["FromTime"]</th>
				<th>@Localizer["ToTime"]</th>
				<th></th>
			</tr>
			</thead>
			<tbody>

			@for (int i = 0; i < reservations.Count; i++)
			{
				<tr>
					<td>@reservations[i].ServerName - @reservations[i].Platform </td>
					<td>@reservations[i].LabId</td>
					<td>@reservations[i].ReservationStart</td>
					<td>@reservations[i].ReservationEnd</td>
					<td>
						<form method="post"><button class="btn btn-danger" onclick="return confirm('Are you sure you want to delete a reservation? This operation is pernament!')" formaction="@Url.Action("DeleteReservation", "Reservation", new { reservationId = @ViewBag.PlannedReservations[i].Id })"> <i class="bi bi-trash"></i> </button></form></td>
				</tr>
			}
			</tbody>
		</table>
	}
	else
	{
		<div class="col-12 text-center mt-4">
			<div class="alert alert-info" role="alert">
				@Localizer["NoReservation"]
			</div>
		</div> 
	}
	<h3>@Localizer["ExpiredReservations"]</h3>
	<p>@Localizer["ExpiredResWarning"]</p>
	@if (expired != null && expired.Count>0)
	{
		<table class="table">
	
			<thead>
			<tr>
				<th>@Localizer["Server"]</th>
				<th>@Localizer["Lab"]</th>
				<th>@Localizer["FromTime"]</th>
				<th>@Localizer["ToTime"]</th>
				<th></th>
			</tr>
			</thead>
			<tbody>
			@for (int i = 0; i < expired.Count; i++)
			{
				<tr>
					<td>@expired[i].ServerName - @expired[i].Platform </td>
					<td>@expired[i].LabId</td>
					<td>@expired[i].ReservationStart</td>
					<td>@expired[i].ReservationEnd</td>
					<td>
						<form method="post"><button class="btn btn-danger" formaction="@Url.Action("DeleteReservation", "Reservation", new { reservationId = @ViewBag.ExpiredReservations[i].Id })"> <i class="bi bi-trash"></i> </button></form></td>
				</tr>
			}
			
			</tbody>
		</table>
	}
	else
	{
		<div class="col-12 text-center mt-4">
			<div class="alert alert-info" role="alert">
				@Localizer["NoExpired"]
			</div>
		</div>
	}
</div>
