@model List<(int ServerId, BusinessLayer.DTOs.LabDTO Lab)>
@{
    ViewData["Title"] = Localizer["MyLabLayout"];
}

<h1 class="mb-0">@ViewData["Title"]</h1>
<hr class="mt-2 mb-4" />

@if (Model != null && Model.Count > 0)
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model)
        {
            var serverId = item.ServerId;
            var lab = item.Lab;

            string status = (lab.Status ?? "").ToLower();
            string badgeClass = status switch
            {
                "started" or "running" => "bg-success",
                "stopped" => "bg-danger",
                "unknown" => "bg-warning text-dark",
                _ => "bg-secondary"
            };

            string statusText = status switch
            {
                "started" or "running" => Localizer["StartedState"].Value,
                "stopped" => Localizer["StoppedState"].Value,
                _ => lab.Status ?? "Unknown"
            };

            <div class="col">
                <div class="card shadow-sm h-100 border-0">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
                            <a href="@Url.Action("LabInfo", "Platform", new { serverId = serverId, labId = lab.Id })" class="text-decoration-none text-body flex-grow-1">
                                <h5 class="card-title fw-bold mb-0 text-truncate" title="@lab.Name">@lab.Name</h5>
                            </a>
                            <span class="badge @badgeClass">@statusText</span>
                        </div>

                        <p class="card-text text-body-secondary small mb-3 flex-grow-1">
                            @if (!string.IsNullOrEmpty(lab.Description))
                            {
                                <span class="d-block text-truncate" title="@lab.Description">@lab.Description</span>
                            }
                            else
                            {
                                <span class="fst-italic text-truncate d-block">@lab.Id</span>
                            }
                        </p>

                        @if (lab.Metadata != null)
                        {
                            <div class="small text-body-secondary mb-3">
                                @if (lab.Metadata.TryGetValue("LastModified", out var lastMod) && !string.IsNullOrEmpty(lastMod))
                                {
                                    <div class="text-truncate mb-1">
                                        <i class="bi bi-clock me-1 text-muted"></i>@lastMod
                                    </div>
                                }
                                @if (lab.Metadata.TryGetValue("Filename", out var filename) && !string.IsNullOrEmpty(filename))
                                {
                                    <div class="text-truncate">
                                        <i class="bi bi-file-earmark me-1 text-muted"></i>@filename
                                    </div>
                                }
                            </div>
                        }

                        <div class="d-flex gap-2 pt-3 border-top mt-auto">
                            <a href="@Url.Action("LabInfo", "Platform", new { serverId = serverId, labId = lab.Id })" class="btn btn-sm btn-primary flex-grow-1">
                                <i class="bi bi-box-arrow-in-right me-1"></i> @Localizer["LabInfo"]
                            </a>
                            <form method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        title="@Localizer["RemoveOwnership"]"
                                        onclick="return confirm('@Localizer["ConfirmRemoveOwnership"]');"
                                        formaction="@Url.Action("RemoveOwnership", "User", new { serverId = serverId, labId = lab.Id })">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="p-5 text-center text-muted">
            <i class="bi bi-diagram-3 fs-1 d-block mb-3 text-secondary"></i>
            <h5 class="fw-normal">@Localizer["NoOwnedLab"]</h5>
        </div>
    </div>
}