@model NetResVM.Web.Models.ChangePasswordModel

<h3>@Localizer["ChangePass"]</h3>
<form method="post" class="p-3 border rounded">
	<div class="form-group mb-3">
		<label for="oldPassword" class="form-label">@Localizer["OldPass"]</label>
		<input type="password" class="form-control" id="oldPassword" name="oldPassword" asp-for="oldPassword" required>
	</div>
	<div class="form-group mb-3">
		<label for="newPassword" class="form-label">@Localizer["NewPass"]</label>
		<input type="password" class="form-control" id="newPassword" name="newPassword" asp-for="newPassword" required>
	</div>
	<div class="form-group mb-3">
		<label for="confirmPassword" class="form-label">@Localizer["ConfirmNewPass"]</label>
		<input type="password" class="form-control" id="confirmPassword" name="confirmPassword" asp-for="confirmPassword" required>
	</div>
	<button type="submit" class="btn btn-primary" formaction="@Url.Action("ChangePassword","User")">@Localizer["ChangePass"]</button>
</form>
