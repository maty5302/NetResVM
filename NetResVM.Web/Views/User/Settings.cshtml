@{
	ViewBag.Title = @Localizer["SettingsTitle"];
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2 mb-3">
	<h1 class="mb-0">@ViewBag.Title</h1>
</div>
<hr class="mb-4" />

<div class="row g-4">
	<div class="col-12 col-md-6">
		@if (ViewBag.UserAuthType == "localhost")
		{
			<partial name="PartialSettings/ChangePasswordPartial" />
		}
		else
		{
			<div class="card shadow-sm">
				<div class="card-header py-2">
					<h5 class="card-title mb-0">@Localizer["ChangePass"]</h5>
				</div>
				<div class="card-body p-4">
					<div class="alert alert-info mb-0" role="alert">
						<i class="bi bi-info-circle me-1"></i> @Localizer["ChangePassLDAP"]
					</div>
				</div>
			</div>
		}
	</div>
	@if (User.IsInRole("Admin"))
	{
		<div class="col-12 col-md-6">
			<partial name="PartialSettings/AddManageUserPartial" />
		</div>
	}
</div>
