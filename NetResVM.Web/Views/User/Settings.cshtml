@{
	ViewBag.Title = @Localizer["SettingsTitle"];
}
<h1>@ViewBag.Title</h1>
<hr />

<div class="row">
	<div class="col-12 col-md-6 mb-4">
		@if (ViewBag.UserAuthType == "localhost")
		{
			@Html.Partial("PartialSettings/ChangePasswordPartial")
		}
		else
		{
			<div class="p-3 border rounded">
				<h3>@Localizer["ChangePass"]</h3>
				<div class="alert alert-info mt-3 mb-0" role="alert">
					<i class="bi bi-info-circle me-1"></i> @Localizer["ChangePassLDAP"]
				</div>
			</div>
		}
	</div>
	@if (User.IsInRole("Admin"))
	{		
		<div class="col-12 col-md-6">
			@Html.Partial("PartialSettings/AddManageUserPartial")
		</div>
	}
</div>
