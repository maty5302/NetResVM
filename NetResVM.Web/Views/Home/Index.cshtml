@{
    ViewData["Title"] = @Localizer["Home"];
    var servers = ViewBag.Servers as List<BusinessLayer.DTOs.ServerDTO>;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2 mb-3">
    <h1 class="mb-0">@Localizer["HomeTitle"]</h1>
    @if (User.IsInRole("Admin"))
    {
        <a href="@Url.Action("Add", "Server")" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> @Localizer["AddNewServ"]
        </a>
    }
</div>
<hr class="mb-4" />

<div class="row g-4">
    @if (servers != null && servers.Count > 0)
    {
        @foreach (var server in servers)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 d-flex">
                <div class="card shadow-sm flex-fill d-flex flex-column">
                    <div class="card-body d-flex flex-column">
                        @* Hlavička karty: Název serveru *@
                        <h5 class="card-title mb-0 text-truncate" title="@server.Name">
                            @server.Name
                        </h5>

                        <hr class="my-2" />

                        @* Informace o platformě a stavu *@
                        <div class="my-1 d-flex flex-column gap-1 text-muted small">
                            <div class="d-flex justify-content-between align-items-center">
                                <span>@Localizer["ServerType"]:</span>
                                <span class="badge bg-secondary">@server.Platform</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span>@Localizer["State"]:</span>
                                @if (server.IsOnline)
                                {
                                    <span class="badge bg-success">Online</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Offline</span>
                                }
                            </div>
                        </div>

                        @* Akční tlačítka dole *@
                        <form method="post" class="mt-auto pt-3 d-flex gap-2">
                            <button class="btn btn-primary flex-grow-1"
                                    type="submit"
                                    formaction="@Url.Action("Index", "Platform", new { serverId = server.Id })">
                                @Localizer["ConnectButton"]
                            </button>

                            @if (User.IsInRole("Admin"))
                            {
                                <button class="btn btn-outline-secondary"
                                        type="submit"
                                        title="Edit"
                                        formaction="@Url.Action("Edit", "Server", new { id = server.Id })">
                                    <i class="bi bi-pen"></i>
                                </button>

                                <button class="btn btn-outline-danger"
                                        type="submit"
                                        title="@Localizer["DeleteButton"]"
                                        onclick="return confirm('Are you sure you want to delete a server? This operation is permanent!')"
                                        formaction="@Url.Action("Remove", "Server", new { id = server.Id })">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>
