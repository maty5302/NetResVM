@model NetResVM.Web.Models.LoginModel
@{
    ViewData["Title"] = "Log in";
}
<div class="row justify-content-center mt-5">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header py-3">
                <h4 class="card-title mb-0">@Localizer["Login"]</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="LoginASync" asp-controller="Login" method="post">
                    <div class="form-group mb-3">
                        <label class="form-label" for="Username">@Localizer["Username"]</label>
                        <input type="text" class="form-control" asp-for="Username" required>
                    </div>

                    <div class="form-group mb-3">
                        <label for="Password" class="form-label">@Localizer["Password"]</label>
                        <input asp-for="Password" class="form-control" type="password" required>
                    </div>
                    <hr class="my-4" />
                    <button type="submit" class="btn btn-primary w-100">@Localizer["LoginButton"]</button>
                </form>
            </div>
        </div>
    </div>
</div>
