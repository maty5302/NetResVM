@model List<BusinessLayer.DTOs.NodeDTO>
@{
    ViewData["Title"] = @Localizer["ShowNodes"];
    bool canAccessConsole = ViewBag.CanAccessConsole == true;
    int serverId = ViewBag.ServerId != null ? (int)ViewBag.ServerId : 0;
    string labId = ViewBag.LabId as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>
    @if (!string.IsNullOrEmpty(labId))
    {
        <a class="btn btn-secondary" href="@Url.Action("LabInfo", "Platform", new { serverId = serverId, labId = labId })">
            <i class="bi bi-arrow-left-circle"></i> @Localizer["Back"]
        </a>
    }
</div>
<hr />

<div class="row">
    @if (Model != null && Model.Count > 0)
    {
        @for (int i = 0; i < Model.Count; i++)
        {
            var node = Model[i];
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4 d-flex">
                <div class="card flex-fill d-flex flex-column shadow-sm">
                    <div class="card-body d-flex flex-column" style="min-height: 200px;">
                        <h5 class="card-title d-flex justify-content-between align-items-center">
                            <span>@node.Name</span><br/>
                        </h5>
                            <small class="text-muted fs-6">(@node.Id)</small>
                         
                        <hr />

                        @* Universal Status with color coding (supports CML STARTED/BOOTED and EVE-NG RUNNING) *@
                        <span class="mb-2 d-block">
                            @{
                                var isStarted = node.Status.Equals("STARTED", StringComparison.OrdinalIgnoreCase)
                                             || node.Status.Equals("BOOTED", StringComparison.OrdinalIgnoreCase)
                                             || node.Status.Equals("RUNNING", StringComparison.OrdinalIgnoreCase);
                                var iconColor = isStarted ? "text-success" : "text-secondary";
                            }
                            <i class="bi bi-caret-right-fill @iconColor"></i>
                            <strong>@node.Status.ToUpper()</strong>
                        </span>

                        @* Standard Properties from NodeDTO *@
                        <span> <i class="bi bi-cpu"></i> CPU: @node.NumberOfCPU</span><br />
                        <span> <i class="bi bi-memory"></i> RAM: @node.Memory MB</span><br />

                        @* Platform-Specific Metadata (Ethernets, HDD, CPU Limit) *@
                        @if (node.Metadata != null && node.Metadata.Any())
                        {
                            @foreach (var meta in node.Metadata)
                            {
                                string icon = "bi-info-circle";
                                if (meta.Key.Contains("Ethernet", StringComparison.OrdinalIgnoreCase)) icon = "bi-ethernet";
                                else if (meta.Key.Contains("HDD") || meta.Key.Contains("Volume")) icon = "bi-hdd";
                                else if (meta.Key.Contains("Limit")) icon = "bi-speedometer2";

                                <span> <i class="bi @icon"></i> @meta.Key: @meta.Value</span><br />
                            }
                        }

                        @* Console Action Button (opens standalone console window) *@
                        <div class="mt-auto pt-3">
                            @if (isStarted && canAccessConsole)
                            {
                                <a href="@Url.Action("NodeConsole", "Platform", new { serverId = serverId, labId = labId, nodeId = node.Id, nodeName = node.Name })"
                                   target="_blank"
                                   rel="noopener"
                                   class="btn btn-sm btn-primary w-100 js-open-console-popup"
                                   title="@Localizer["OpenConsoleNewWindow"]">
                                    <i class="bi bi-terminal"></i> @Localizer["OpenConsole"] <i class="bi bi-box-arrow-up-right ms-1"></i>
                                </a>
                            }
                            else
                            {
                                string disabledHint = !isStarted
                                    ? Localizer["ConsoleNodeStoppedHint"].Value
                                    : Localizer["ConsoleNoAccessHint"].Value;
                                <span class="d-inline-block w-100" tabindex="0" title="@disabledHint">
                                    <button type="button" class="btn btn-sm btn-outline-secondary w-100" disabled>
                                        <i class="bi bi-terminal"></i> @Localizer["OpenConsole"]
                                    </button>
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* Wrap rows nicely *@
            @if ((i + 1) % 4 == 0)
            {
                <div class="w-100 d-none d-lg-block"></div>
            }
        }
    }
    else
    {
        <div class="col-12 text-center mt-4">
            <div class="alert alert-info" role="alert">
                No nodes available in this lab.
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('.js-open-console-popup').forEach(function (link) {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const windowName = 'NetResVM_Console_' + Math.random().toString(36).substring(2, 9);
                    const popup = window.open(this.href, windowName, 'width=960,height=620,resizable=yes,scrollbars=no');
                    if (popup) {
                        popup.focus();
                    } else {
                        window.open(this.href, '_blank', 'noopener');
                    }
                });
            });
        })();
    </script>
}