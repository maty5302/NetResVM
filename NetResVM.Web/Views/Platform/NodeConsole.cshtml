@{
    Layout = null;
    int serverId = ViewBag.ServerId != null ? (int)ViewBag.ServerId : 0;
    string labId = ViewBag.LabId as string ?? "";
    string nodeId = ViewBag.NodeId as string ?? "";
    string nodeName = ViewBag.NodeName as string ?? nodeId;
    string serverName = ViewBag.ServerName as string ?? "";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@nodeName (@nodeId) - @Localizer["ConsoleTitle"] - NetResVM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.min.css" />
    <style>
        html, body {
            height: 100%;
            margin: 0;
            background-color: #0d1117;
            color: #e6edf3;
            overflow: hidden;
        }
        .console-wrapper {
            display: flex;
            flex-direction: column;
            height: 100vh;
        }
        .console-toolbar {
            background-color: #161b22;
            border-bottom: 1px solid #30363d;
            padding: 0.45rem 0.85rem;
            flex-shrink: 0;
        }
        #terminalContainer {
            flex-grow: 1;
            width: 100%;
            padding: 6px;
            overflow: hidden;
        }
    </style>
</head>
<body>
    <div class="console-wrapper">
        <div class="console-toolbar d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-terminal-fill text-info"></i>
                <strong>@nodeName</strong>
                <span class="text-secondary small">(@nodeId — @serverName)</span>
                <span id="consoleStatusBadge" class="badge bg-warning text-dark ms-2">@Localizer["ConsoleConnecting"]</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" id="btnReconnectConsole" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-arrow-clockwise"></i> @Localizer["ReconnectConsole"]
                </button>
            </div>
        </div>
        <div id="terminalContainer"></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.min.js"></script>
    <script>
        (function () {
            const serverId = @serverId;
            const labId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(labId));
            const nodeId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(nodeId));
            const wsBasePath = '@Url.Action("ConsoleWs", "Platform")';

            const txtConnecting = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ConsoleConnecting"].Value));
            const txtConnected = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ConsoleConnected"].Value));
            const txtDisconnected = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ConsoleDisconnected"].Value));

            const statusBadgeEl = document.getElementById('consoleStatusBadge');
            const terminalContainer = document.getElementById('terminalContainer');
            const btnReconnect = document.getElementById('btnReconnectConsole');

            let term = null;
            let fitAddon = null;
            let ws = null;

            function setStatus(state) {
                if (state === 'connecting') {
                    statusBadgeEl.className = 'badge bg-warning text-dark ms-2';
                    statusBadgeEl.textContent = txtConnecting;
                } else if (state === 'connected') {
                    statusBadgeEl.className = 'badge bg-success ms-2';
                    statusBadgeEl.textContent = txtConnected;
                } else {
                    statusBadgeEl.className = 'badge bg-danger ms-2';
                    statusBadgeEl.textContent = txtDisconnected;
                }
            }

            function connectSession() {
                if (ws) {
                    try {
                        ws.onclose = null;
                        ws.close();
                    } catch (_) { }
                    ws = null;
                }
                if (term) {
                    try {
                        term.dispose();
                    } catch (_) { }
                }
                terminalContainer.innerHTML = '';

                term = new Terminal({
                    cursorBlink: true,
                    fontSize: 14,
                    fontFamily: 'Menlo, Monaco, Consolas, "Courier New", monospace',
                    theme: {
                        background: '#0d1117',
                        foreground: '#e6edf3',
                        cursor: '#58a6ff'
                    }
                });

                fitAddon = new FitAddon.FitAddon();
                term.loadAddon(fitAddon);
                term.open(terminalContainer);
                fitAddon.fit();
                term.focus();

                setStatus('connecting');

                const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
                const cols = term.cols || 120;
                const rows = term.rows || 32;
                const wsUrl = `${protocol}//${window.location.host}${wsBasePath}?serverId=${encodeURIComponent(serverId)}&labId=${encodeURIComponent(labId)}&nodeId=${encodeURIComponent(nodeId)}&cols=${cols}&rows=${rows}`;

                ws = new WebSocket(wsUrl);
                ws.binaryType = 'arraybuffer';

                ws.onopen = function () {
                    setStatus('connected');
                    term.focus();
                };

                ws.onmessage = function (event) {
                    if (event.data instanceof ArrayBuffer) {
                        term.write(new Uint8Array(event.data));
                    } else {
                        term.write(event.data);
                    }
                };

                ws.onclose = function () {
                    setStatus('disconnected');
                    if (term) {
                        term.writeln('\r\n\x1b[33m[NetResVM] Session closed.\x1b[0m');
                    }
                };

                ws.onerror = function () {
                    setStatus('disconnected');
                };

                term.onData(function (data) {
                    if (ws && ws.readyState === WebSocket.OPEN) {
                        ws.send(data);
                    }
                });
            }

            window.addEventListener('resize', function () {
                if (fitAddon && term) {
                    try {
                        fitAddon.fit();
                    } catch (_) { }
                }
            });

            btnReconnect.addEventListener('click', connectSession);

            connectSession();
        })();
    </script>
</body>
</html>
