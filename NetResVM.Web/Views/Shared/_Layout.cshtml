@using Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NetResVM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NetResVM.Web.styles.css" asp-append-version="true" />
    <script>
        (function () {
            var storedTheme = localStorage.getItem("theme");
            if (storedTheme) {
                document.documentElement.setAttribute("data-bs-theme", storedTheme);
            }
        })();
    </script>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm bg-body text-body border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-hdd-network text-primary me-1"></i>NetResVM
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-body" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>@Localizer["Home"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-body" asp-area="" asp-controller="Reservation" asp-action="Index"><i class="bi bi-calendar me-1"></i>@Localizer["ReservationLayout"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-body" asp-area="" asp-controller="User" asp-action="UserLab"><i class="bi bi-diagram-3 me-1"></i>@Localizer["MyLabLayout"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-body" asp-area="" asp-controller="Backup" asp-action="Index"><i class="bi bi-database-gear me-1"></i>@Localizer["BackupsLayout"]</a>
                            </li>
                        }
                    </ul>

                    @{
                        var currentCulture = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>()?.RequestCulture.UICulture.Name ?? "en-US";
                        var nextCulture = currentCulture == "cs-CZ" ? "en-US" : "cs-CZ";
                        var currentFlag = currentCulture == "cs-CZ" ? "🇨🇿" : "🇬🇧";
                        var currentLangLabel = currentCulture == "cs-CZ" ? "Čeština (kliknutím přepnout na English)" : "English (click to switch to Čeština)";
                    }

                    @* User settings *@
                    <div class="d-flex align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a href="@Url.Action("Settings", "User")"
                               class="btn btn-sm btn-link text-body text-decoration-none px-2 d-flex align-items-center gap-1"
                               title="@Localizer["SettingsTitle"]">
                                <i class="bi bi-person-circle fs-5"></i>
                                <span>@User.Identity.Name</span>
                            </a>

                            <div class="vr mx-1 my-auto" style="height: 22px;"></div>
                        }

                        @* AI Assistant *@
                        @if(User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <input type="checkbox" id="aiPanelToggle" class="d-none" />
                            <label for="aiPanelToggle"
                                   class="btn btn-sm btn-link text-body text-decoration-none px-2 mb-0"
                                   id="btnAiAssistant"
                                   role="button"
                                   title="@Localizer["AiAssistantTitle"]">
                                <i class="bi bi-stars fs-5 text-primary"></i>
                            </label>
                            

                            <div class="vr mx-1 my-auto" style="height: 22px;"></div>
                        }
                        @* Dark / Light theme *@
                        <button type="button"
                                class="btn btn-sm btn-link text-body text-decoration-none px-2"
                                id="btnSwitch"
                                title="Dark / Light theme">
                            <i id="themeIcon" class="bi bi-sun-fill fs-5"></i>
                        </button>

                        <div class="vr mx-1 my-auto" style="height: 22px;"></div>

                        @* Language switcher *@
                        <form asp-controller="Culture" asp-action="SetLanguage" method="post" class="d-inline mb-0">
                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                            <input type="hidden" name="culture" value="@nextCulture" />
                            <button type="submit"
                                    class="btn btn-sm btn-link text-body text-decoration-none px-2 fs-5 lh-1"
                                    title="@currentLangLabel">
                                @currentFlag
                            </button>
                        </form>

                        <div class="vr mx-1 my-auto" style="height: 22px;"></div>

                        @* Log in / Log out *@
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <form method="post" class="d-inline mb-0">
                                <button class="btn btn-sm btn-link text-danger text-decoration-none px-2"
                                        type="submit"
                                        formaction="@Url.Action("Logout", "Login")"
                                        title="@Localizer["LogoutLayout"]">
                                    <i class="bi bi-box-arrow-right fs-5"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", "Login")"
                               class="btn btn-sm btn-link text-body text-decoration-none px-2"
                               title="@Localizer["Login"]">
                                <i class="bi bi-box-arrow-in-right fs-5"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container flex-grow-1">
        <div class="text-center">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    @TempData["ErrorMessage"]
                </div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success" role="alert">
                    @TempData["SuccessMessage"]
                </div>
            }
        </div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-auto py-3">
        <div class="container">
            &copy; 2026 - NetResVm
        </div>
    </footer>

    @* Pravý vysouvací AI panel (ovládaný přes #aiPanelToggle bez JS) *@
    <aside class="ai-side-panel bg-body text-body border-start shadow-sm d-flex flex-column" aria-label="@Localizer["AiAssistantTitle"]">
        <div class="d-flex align-items-center justify-content-between p-3 border-bottom">
            <h6 class="mb-0 fw-semibold d-flex align-items-center gap-2">
                <i class="bi bi-stars text-primary"></i>
                @Localizer["AiAssistantTitle"]
            </h6>
            <label for="aiPanelToggle" class="btn-close" role="button" aria-label="@Localizer["Close"]" title="@Localizer["Close"]"></label>
        </div>

        <div class="flex-grow-1 p-3 overflow-auto d-flex flex-column gap-2">
            <div class="p-3 rounded-3 bg-body-secondary text-body small border">
                <div class="fw-semibold mb-1 d-flex align-items-center gap-1 text-primary">
                    <i class="bi bi-robot"></i> @Localizer["AiAssistantTitle"]
                </div>
                <div>@Localizer["AiAssistantUnavailable"]</div>
            </div>
        </div>

        <div class="p-3 border-top bg-body-tertiary">
            <div class="input-group input-group-sm">
                <input type="text"
                       class="form-control"
                       placeholder="@Localizer["AiAssistantInputPlaceholder"]"
                       aria-label="@Localizer["AiAssistantInputPlaceholder"]"
                       disabled />
                <button class="btn btn-primary" type="button" title="@Localizer["AiAssistantSend"]" disabled>
                    <i class="bi bi-send"></i>
                </button>
            </div>
        </div>
    </aside>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        @Html.AntiForgeryToken()
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
