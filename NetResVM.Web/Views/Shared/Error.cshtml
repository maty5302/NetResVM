@model ErrorViewModel
@{
    ViewData["Title"] = Localizer["Error"]?.Value ?? "Error";
}

<div class="row justify-content-center my-5">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white text-center py-3">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>@(Localizer["Error"]?.Value ?? "Chyba")</h4>
            </div>
            <div class="card-body text-center p-4">
                <p class="fs-5 text-secondary">
                    @(Localizer["AnErrorOccurred"]?.Value ?? "Při zpracování vašeho požadavku došlo k neočekávané chybě.")
                </p>

                @if (Model?.ShowRequestId == true)
                {
                    <div class="alert alert-light border mt-3 py-2">
                        <small class="text-muted">Request ID: <code>@Model.RequestId</code></small>
                    </div>
                }

                <div class="mt-4">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary px-4">
                        <i class="bi bi-house-door me-1"></i>@(Localizer["BackToHome"]?.Value ?? "Zpět na hlavní stránku")
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
